# Optional — only needed for VOICE mode. Text chat uses your Grok CLI login.
# XAI_API_KEY=xai-...

# Local desk HTTP port (serves UI + voice-token + WS bridge)
PORT=8787

# Working directory the agent opens with (default: your home)
# GROK_CWD=/Users/you/Documents

# Path to grok binary (auto-detected if on PATH or ~/.grok/bin/grok)
# GROK_BIN=/Users/you/.grok/bin/grok

# Auto-approve all agent tool runs (recommended for personal desk)
# Prefer settings.permissionMode in Desk UI (ask | auto | always-approve)
# GROK_ALWAYS_APPROVE=1

# Web Push VAPID contact (mailto: or https:)
# VAPID_SUBJECT=mailto:you@example.com

# Weekly Feature Radar email (Resend)
# RESEND_API_KEY=re_...
# RADAR_DIGEST_TO=you@example.com
# RADAR_DIGEST_FROM=Grok Desk Radar <onboarding@resend.dev>
