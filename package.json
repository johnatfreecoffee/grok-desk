{
  "name": "grok-desk",
  "productName": "Grok Desk",
  "version": "0.2.0",
  "private": false,
  "description": "Local visual desk for Grok Build — Speak TTS, menu-bar Folders, grok.com phone connector",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/johnatfreecoffee/grok-desk.git"
  },
  "bugs": {
    "url": "https://github.com/johnatfreecoffee/grok-desk/issues"
  },
  "homepage": "https://github.com/johnatfreecoffee/grok-desk#readme",
  "type": "module",
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build --prefix web",
    "start": "node daemon/index.js",
    "desk": "npm run build && node daemon/index.js",
    "app": "npm run make-app && open -a 'Grok Desk'",
    "app:dev": "electron .",
    "make-app": "bash scripts/make-app.sh",
    "pack": "bash scripts/pack.sh",
    "pack:linux": "bash scripts/pack.sh linux",
    "pack:win": "bash scripts/pack.sh win",
    "test:auto": "node --experimental-strip-types scripts/smoke-automations.mjs",
    "phone": "bash scripts/phone-serve.sh",
    "always-on": "bash scripts/install-launchd.sh",
    "radar": "node daemon/radar/scanner.mjs",
    "radar:digest": "node daemon/radar/digest.mjs",
    "radar:digest:dry": "node daemon/radar/digest.mjs --dry",
    "smoke": "node scripts/smoke-desk.mjs",
    "smoke:turns": "node scripts/smoke-turn-resilience.mjs",
    "smoke:isolation": "node scripts/smoke-thread-isolation.mjs",
    "smoke:resume": "node scripts/smoke-session-resume.mjs",
    "smoke:feed": "node scripts/smoke-feed-ws.mjs",
    "test:speak": "node scripts/speak-unit.mjs",
    "test:feed": "node scripts/feed-unit.mjs",
    "test:store": "node --experimental-strip-types scripts/session-store-unit.mjs",
    "smoke:switch": "node --experimental-strip-types scripts/smoke-switch.mjs",
    "smoke:reload": "node --experimental-strip-types scripts/smoke-reload.mjs",
    "smoke:cli": "node --experimental-strip-types scripts/smoke-cli.mjs",
    "smoke:longturn": "node --experimental-strip-types scripts/smoke-longturn.mjs"
  },
  "dependencies": {
    "web-push": "^3.6.7",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "electron": "^36.4.0"
  },
  "engines": {
    "node": ">=20"
  }
}
